crypto isakmp policy 10
 encr aes
 hash md5
 authentication pre-share
 group 5
 lifetime 1000
crypto isakmp key TLN03 address 190.0.1.1
!
crypto ipsec transform-set TS-TO-HQ esp-3des esp-md5-hmac
 mode transport
!
crypto ipsec profile PF-TO-HQ
 set transform-set TS-TO-HQ
!
interface Loopback0
 ip address 190.0.2.1 255.255.255.255
!
interface Ethernet0/1
 ip address 10.0.5.6 255.255.255.252
 ip nat outside
!
interface Ethernet0/2
 no ip address
 no shutdown
!
interface Ethernet0/2.5
 encapsulation dot1q 5
 ip address 192.168.50.3 255.255.255.0
 ip nat inside
 vrrp 5 ip 192.168.50.1
 vrrp 5 priority 95
 no shutdown
!
interface Ethernet0/2.15
 encapsulation dot1q 15
 ip address 192.168.150.3 255.255.255.0
 ip nat inside
 vrrp 15 ip 192.168.150.1
 vrrp 15 priority 95
 no shutdown
!
interface Tunnel1
 ip address 172.16.40.2 255.255.255.252
 tunnel source 190.0.2.1
 tunnel destination 190.0.1.1
 ip ospf hello-interval 5
 ip ospf dead-interval 20
 tunnel protection ipsec profile PF-TO-HQ
!
router ospf 10
 router-id 6.6.6.6
 passive-interface ethernet0/2.5
 passive-interface ethernet0/2.15
 network 172.16.40.0 0.0.0.3 area 0
 network 192.168.50.0 0.0.0.255 area 0
 network 192.168.150.0 0.0.0.255 area 0
!
router bgp 200
 bgp router-id 190.0.2.1
 no bgp default ipv4-unicast
 neighbor 10.0.5.5 remote-as 200
 !
 address-family ipv4
  network 190.0.2.1 mask 255.255.255.255
  neighbor 10.0.5.5 activate
  neighbor 10.0.5.5 next-hop-self
 exit-address-family
!
ip access-list standard 10
 10 permit 192.168.50.0 0.0.0.255
 20 permit 192.168.150.0 0.0.0.255
!
ip nat pool BRANCH2BK-POOL 190.0.2.2 190.0.2.6 prefix-length 29
ip nat inside source list 10 pool BRANCH2BK-POOL overload route-map RM-NAT-ONLY
!
route-map RM-NAT-ONLY permit 10
 match interface Ethernet0/1
!
ip forward-protocol nd
!
ip http server
ip http secure-server
ip route 0.0.0.0 0.0.0.0 10.0.5.5
!
ip ftp username dubuntu
ip ftp password 123456