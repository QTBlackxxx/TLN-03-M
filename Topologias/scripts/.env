# =============================================================================
# CREDENCIALES GLOBALES
# =============================================================================
NET_USER=admin
NET_PASS=admin


# =============================================================================
# GRUPOS DE DISPOSITIVOS
# =============================================================================

# Branch2 
GROUP_BRANCH2=B2,B2BK

# Todos los demás dispositivos
GROUP_OTHERS=HQ,HQBK,BR,BRBK,M3,C5,M2,C2


# =============================================================================
# CPE-BRANCH2  |  spoke primario DMVPN 1  |  VRRP master
# =============================================================================
B2_HOST=clab-ISP-TDP-CLARO-IOL-CPE-BRANCH2
B2_HOSTNAME=CPE-BRANCH2

# --- Módulos a desplegar ---
B2_MODULE_TUNNEL=tunnel_spoke
B2_MODULE_ROUTING_TRACKING=true
B2_MODULE_ROUTING_VRRP=master
B2_MODULE_ROUTING_EIGRP=true
B2_MODULE_ROUTING_STATIC=true
B2_MODULE_ROUTING_NAT=true

# --- Loopback ---
B2_LOOPBACK_IP=200.0.2.1

# --- WAN ---
B2_WAN_IFACE=Ethernet0/1
B2_WAN_IP=10.0.0.74
B2_WAN_MASK=255.255.255.252

# --- LAN ---
B2_LAN_IFACE=Ethernet0/2

B2_SUBIF_1_VLAN=25
B2_SUBIF_1_IP=192.168.25.2
B2_SUBIF_1_MASK=255.255.255.0
B2_SUBIF_1_VRRP_VIP=192.168.25.1

B2_SUBIF_2_VLAN=30
B2_SUBIF_2_IP=192.168.30.2
B2_SUBIF_2_MASK=255.255.255.0
B2_SUBIF_2_VRRP_VIP=192.168.30.1

# --- VRRP ---
B2_VRRP_ROLE=master
B2_VRRP_PREEMPT=true
B2_VRRP_TRACK_IDS=5,10,15,20

# --- Tracking ---
B2_TRACK_5=192.168.5.0/255.255.255.0
B2_TRACK_10=192.168.10.0/255.255.255.0
B2_TRACK_15=192.168.15.0/255.255.255.0
B2_TRACK_20=192.168.20.0/255.255.255.0

# --- Tunnel DMVPN ---
B2_TUNNEL_ID=1
B2_TUNNEL_IP=172.16.10.3
B2_TUNNEL_MASK=255.255.255.248
B2_TUNNEL_SOURCE=200.0.2.1
B2_NHRP_AUTH=DMVPN
B2_NHRP_NET_ID=1
B2_NHRP_NHS_IP=172.16.10.1
B2_NHRP_NHS_NBMA=200.0.0.1

# --- EIGRP ---
B2_EIGRP_AS=10
B2_EIGRP_ROUTER_ID=5.5.5.5
B2_EIGRP_NETWORKS=172.16.10.0/0.0.0.7,192.168.25.0/0.0.0.255,192.168.30.0/0.0.0.255

# --- NAT ---
B2_NAT_ACL_PERMITS=192.168.25.0/0.0.0.255,192.168.30.0/0.0.0.255
B2_NAT_POOL_NAME=BRANCH2-POOL
B2_NAT_POOL_START=200.0.2.2
B2_NAT_POOL_END=200.0.2.6
B2_NAT_POOL_PREFIX=29


